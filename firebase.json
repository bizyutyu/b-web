{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*"],
    "trailingSlash": false,
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/input", "destination": "/index.html" },
      { "source": "/output", "destination": "/index.html" },
      { "source": "/output/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; connect-src 'self' https://firestore.googleapis.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
